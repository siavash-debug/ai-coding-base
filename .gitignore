# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/

# test output
coverage/

# pnpm
pnpm-debug.log*

# env / secrets (never commit)
.env
.env.*
# `.env.local` holds a developer's own credentials: ignored explicitly as well as by
# the `.env.*` rule above, so it cannot be staged even if that rule is ever narrowed.
.env.local
!.env.example

# local AI runtime state (event logs, task records) — never committed
.ai/runtime/

# local agent tooling state — tool metadata is not project source and must never
# be committed (see AGENTS.md section 8.1 / ADR-044). `.cline/` is deliberately NOT
# here: `.cline/rules/workspace.md` is a committed adapter that points at AGENTS.md.
.freebuff/
.kilo/

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log
