{
  "name": "ai-coding-base",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable professional AI Engineering coding workspace (baseline, not an application).",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "verify": "bash scripts/verify.sh",
    "git:identity": "bash scripts/check-git-identity.sh",
    "ai": "node ./dist/cli/run.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
